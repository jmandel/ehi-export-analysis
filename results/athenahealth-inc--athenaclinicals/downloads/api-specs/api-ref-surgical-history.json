[
  {
    "title": "Surgical History",
    "site": "api",
    "subtitle": null,
    "body": {
      "data": {},
      "content": [
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "The Surgical History feature allows the user to record, update or view the detail of historical procedures performed on the patient.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "athenaOne does not have the concept of a single list of all procedures performed on a patient. To collect all CPT codes associated with a patient, you need to pull the surgical history, all of the claims for that patient, and possibly the procedure orders.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "Surgical history is always manually updated by a user in athenaOne or updated by an external data source, most commonly an interface or CCDA import. athenahealth doesn\u2019t automatically convert procedures from claims into surgical history.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "value": "SURGICAL",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "The surgical history section again contains a list of checkbox questions, with an optional list of surgery dates.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "'DEFAULT' is the Y/N checkbox that indicates whether the patient had this surgery before. If 'DEFAULT' is Y, then the SURGERYDATE is an optional list of surgery dates. Even one surgery date should be submitted as a (singleton) list.",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            },
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "'surgicalhistoryprocedureid' ties it to the practice-specific surgical history question and can be used to tie the same question across multiple forms.",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            },
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "'procedurecode' is the CPT code of the procedure, if configured as such by the practice. text is the patient-friendly name of the surgical history question.",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            }
          ],
          "nodeType": "unordered-list"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
      ],
      "nodeType": "document"
    },
    "urlAlias": "/api-ref/surgical-history",
    "primaryEndpoints": [
      {
        "endpointTitle": "Add surgical history data to patient's chart",
        "endpointDescription": "Record historical surgery information performed on a specific patient",
        "apiCatalog": "Chart.yaml",
        "httpMethod": "POST",
        "endpointUrl": "/v1/{practiceid}/chart/{patientid}/surgicalhistory",
        "operationId": "postPracticeidChartPatientidSurgicalhistory",
        "inputParameters": [
          {
            "in": "path",
            "name": "practiceid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "practiceid"
          },
          {
            "in": "path",
            "name": "patientid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "patientid"
          },
          {
            "in": "header",
            "name": "Content-Type",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Content type of the payload"
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "PATIENTFACINGCALL": {
                    "description": "When 'true' is passed we will collect relevant data and store in our database.",
                    "type": "boolean"
                  },
                  "THIRDPARTYUSERNAME": {
                    "description": "User name of the patient in the third party application.",
                    "type": "string"
                  },
                  "departmentid": {
                    "description": "The athenaNet department id.",
                    "type": "integer"
                  },
                  "procedures": {
                    "description": "A JSON array of procedures, mimicking <a href=\"https://docs.athenahealth.com/api/api-ref/surgical-history\">the inputs</a> described in the PUT/POST call. It is good practice to use the POST call whenever adding new surgical history, however it can only save historical procedures, regardless of input source. Do take note that when calling PUT, any procedures without a procedureid in the PUT call will also add new history. The PUT endpoint can only operate on procedures with source 'historical' and not 'encounter'. Please note a procedure's source cannot be changed after its creation.",
                    "items": {
                      "properties": {
                        "delete": {
                          "description": "Remove the answer to this question",
                          "type": "boolean"
                        },
                        "note": {
                          "description": "Any additional notes",
                          "type": "string"
                        },
                        "procedurecode": {
                          "description": "Procedure code identifying the performed procedure for the given surgery",
                          "type": "string"
                        },
                        "proceduredate": {
                          "description": "Effective date of the procedure",
                          "type": "string"
                        },
                        "procedureid": {
                          "description": "Athena ID for this surgery",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "sectionnote": {
                    "description": "Any additional section notes",
                    "type": "string"
                  }
                },
                "required": [
                  "departmentid"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "outputParameters": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "enum": [
                        "",
                        false,
                        true
                      ],
                      "type": "string",
                      "description": "Whether the operation was successful."
                    },
                    "errormessage": {
                      "type": "string",
                      "description": "If the operation failed, this will contain any error messages."
                    },
                    "procedureids": {
                      "type": "string",
                      "description": "Procedure IDs of newly created procedures in surgical history"
                    }
                  }
                }
              }
            },
            "description": "Success"
          }
        },
        "exampleCode": null,
        "tags": [
          "Chart",
          "Surgical History"
        ],
        "endpointFlags": {
          "x-internal-only": false,
          "x-omit-from-docs": false,
          "x-omit-from-try-it-now": false,
          "x-swagger-router-controller": "passthrough"
        },
        "certifiedApi": false
      },
