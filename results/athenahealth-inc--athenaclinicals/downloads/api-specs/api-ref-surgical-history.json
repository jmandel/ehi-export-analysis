          {
            "in": "query",
            "name": "THIRDPARTYUSERNAME",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "User name of the patient in the third party application."
          },
          {
            "in": "query",
            "name": "PATIENTFACINGCALL",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When 'true' is passed we will collect relevant data and store in our database."
          }
        ],
        "requestBody": null,
        "outputParameters": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "notelastmodifiedby": {
                      "description": "Last username to modify the surgical history note",
                      "type": "string"
                    },
                    "notelastmodifieddatetime": {
                      "description": "Last date and time the surgical history note was modified",
                      "type": "string"
                    },
                    "procedures": {
                      "description": "List of performed procedures",
                      "items": {
                        "properties": {
                          "description": {
                            "description": "Surgery description for this procedure code",
                            "type": "string"
                          },
                          "lastmodifiedby": {
                            "description": "Last username to modify the surgical history procedure.",
                            "type": "string"
                          },
                          "lastmodifieddatetime": {
                            "description": "Last date and time the surgical history procedure was modified.",
                            "type": "string"
                          },
                          "note": {
                            "description": "Additional note for this surgery, if available",
                            "type": "string"
                          },
                          "procedurecode": {
                            "description": "Procedure code",
                            "type": "string"
                          },
                          "proceduredate": {
                            "description": "Date when the surgery was performed",
                            "type": "string"
                          },
                          "procedureid": {
                            "description": "Athena ID for this surgery",
                            "type": "integer"
                          },
                          "providerid": {
                            "description": "ID of the provider that performed this procedure. Only returned for entries with source=\"encounter\".",
                            "type": "integer"
                          },
                          "source": {
                            "description": "Source of this procedure. Can be encounter (if performed) or historical",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "sectionnote": {
                      "description": "Additional note for the entire surgical history section, if any",
                      "type": "string"
                    },
                    "versiontoken": {
                      "description": "Version Token for the data being returned",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "exampleCode": "curl -X GET \"https://api.preview.platform.athenahealth.com/v1/{contextId}/chart/{patientId}/surgicalhistory?departmentid={departmentId}\" -H \"accept: application/json\" -H \"Authorization: Bearer {bearerToken}\"",
        "tags": [
          "Chart",
          "Surgical History"
        ],
        "endpointFlags": {
          "x-internal-only": false,
          "x-omit-from-docs": false,
          "x-omit-from-try-it-now": false,
          "x-swagger-router-controller": "passthrough"
        },
        "certifiedApi": false
