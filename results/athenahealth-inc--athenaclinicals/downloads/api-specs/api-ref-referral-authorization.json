[
  {
    "title": "Referral Authorization",
    "site": "api",
    "subtitle": null,
    "body": {
      "data": {},
      "content": [
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "The Referral Authorization feature allows the user to interface with a patient's authorizations and referrals. Authorizations and referrals are attached to specific patient insurance policies; multiple authorizations and referrals can be added to a specific policy. Authorizations and referrals are identified using an authorization or referral number. Currently, PreCertification authorizations are not available via POST and PUT.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
      ],
      "nodeType": "document"
    },
    "urlAlias": "/api-ref/referral-authorization",
    "primaryEndpoints": [
      {
        "endpointTitle": "Submit referral-authorizations",
        "endpointDescription": "Adds new referral authorizations for a specific patient",
        "apiCatalog": "Insurance_Financial.yaml",
        "httpMethod": "POST",
        "endpointUrl": "/v1/{practiceid}/patients/{patientid}/referralauths",
        "operationId": "postPracticeidPatientsPatientidReferralauths",
        "inputParameters": [
          {
            "in": "path",
            "name": "practiceid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "practiceid"
          },
          {
            "in": "path",
            "name": "patientid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "patientid"
          },
          {
            "in": "header",
            "name": "Content-Type",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Content type of the payload"
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "departmentid",
                  "referringproviderid",
                  "insuranceid"
                ],
                "properties": {
                  "note": {
                    "type": "string",
                    "description": "The note attached to this referral authorization."
                  },
                  "startdate": {
                    "type": "string",
                    "description": "The start date of when the referral authorization is valid."
                  },
                  "visitsleft": {
                    "type": "integer",
                    "description": "The number of visits remaining from this authorization."
                  },
                  "insuranceid": {
                    "type": "integer",
                    "description": "The athena patient insurance ID."
                  },
                  "departmentid": {
                    "type": "integer",
                    "description": "The department ID associated with this authorization."
                  },
                  "appointmentids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "The appointment ID associated with this authorization."
                  },
                  "expirationdate": {
                    "type": "string",
                    "description": "The expiration date of when the referral authorization is valid."
                  },
                  "procedurecodes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The procedure codes (CPT) associated with this referral authorization. Procedure Codes should be given in double quotes only. Example: [\"00770\",\"15000,AS\",\"0147T\"]"
                  },
                  "visitsapproved": {
                    "type": "integer",
                    "description": "The number of visits approved by this authorization."
                  },
                  "notestoprovider": {
                    "type": "string",
                    "description": "The notes for the provider."
                  },
                  "specifiesvisits": {
                    "type": "boolean",
                    "description": "Determines whether or not this authorization specifies visits."
                  },
                  "icd9diagnosiscodes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The ICD9 codes associated with this referral authorization."
                  },
                  "noreferralrequired": {
                    "type": "boolean",
                    "description": "If set to true, then the insurance authorization number is not required."
                  },
                  "referralauthnumber": {
                    "type": "string",
                    "description": "The referral authorization number.  This input can by bypassed with the NOREFERRALREQUIRED parameter."
                  },
                  "icd10diagnosiscodes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The ICD10 codes associated with this referral authorization."
                  },
                  "referringproviderid": {
                    "type": "integer",
                    "description": "The athena referring provider ID associated with this authorization."
                  }
                }
              }
            }
          },
          "required": true
        },
        "outputParameters": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "referralauthid": {
                      "description": "The ID of the referral authorization created.",
                      "type": "integer"
                    },
                    "success": {
                      "description": "True if the API was successfully processed.",
                      "enum": [
                        "",
                        false,
                        true
                      ],
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "exampleCode": null,
        "tags": [
          "Insurance/Financial",
          "Authorizations and Referrals"
        ],
