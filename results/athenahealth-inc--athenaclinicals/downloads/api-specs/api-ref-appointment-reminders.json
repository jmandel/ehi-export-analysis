[
  {
    "title": "Appointment Reminders",
    "site": "api",
    "subtitle": null,
    "body": {
      "nodeType": "document",
      "data": {},
      "content": [
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Appointment reminders are for prompting the practice to schedule future or follow-up appointments for its patients. API users can create, update, retrieve, and delete appointment reminders. Within athenaOne, appointment reminders are referenced as \"Appointment Ticklers.\"",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "heading-2",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Retrieving and Creating Appointment Reminders",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "API users can retrieve all appointment reminders from specific departments within a practice, or a single patient.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Only one appointment reminder can be created per call in athenaOne. API users are required to provide an approximate date to schedule the appointment and must include the department ID, and the patient\u2019s ID. Additional fields are also available to provide more information about the reminder.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "All appointment reminders that are created successfully will generate an API response that includes an appointmentreminderid along with the value \u201cSuccess: True.\u201d",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Before creating new appointment reminders for patients, API users should use the GET call to avoid duplicate appointment reminders.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "heading-2",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Updating and Deleting Appointment Reminders",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "In order to edit/delete a document, API users will need the appointmentreminderid of the document they want to edit/delete.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "All appointment reminders that are updated/deleted successfully will generate an API response that includes an appointmentreminderid along with the value \u201cSuccess: True.\u201d",
              "marks": [],
              "data": {}
            }
          ]
        }
      ]
    },
    "urlAlias": "/api-ref/appointment-reminders",
    "primaryEndpoints": [
      {
        "endpointTitle": "Create appointment reminder",
        "endpointDescription": "Creates an appointment reminder to indicate to the practice when a patient should be scheduled for a future appointment.",
        "apiCatalog": "Appointments.yaml",
        "httpMethod": "POST",
        "endpointUrl": "/v1/{practiceid}/appointments/appointmentreminders",
        "operationId": "postPracticeidAppointmentsAppointmentreminders",
        "inputParameters": [
          {
            "in": "path",
            "name": "practiceid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "practiceid"
          },
          {
            "in": "header",
            "name": "Content-Type",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Content type of the payload"
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "approximatedate",
                  "departmentid",
                  "patientid"
                ],
                "properties": {
                  "note": {
                    "type": "string",
                    "description": "Miscellaneous notes for this reminder."
                  },
                  "patientid": {
                    "type": "integer",
                    "description": "An athenaNet patient ID."
                  },
                  "providerid": {
                    "type": "integer",
                    "description": "An athenaNet provider ID."
                  },
                  "departmentid": {
                    "type": "integer",
                    "description": "An athenaNet department ID."
                  },
                  "approximatedate": {
                    "type": "string",
                    "description": "The approximate date on which an appointment for this reminder should be scheduled."
                  },
                  "appointmenttypeid": {
                    "type": "integer",
                    "description": "An athenaNet appointment type ID."
                  },
                  "patientinstructions": {
                    "type": "string",
                    "description": "Patient instructions regarding this reminder."
                  }
                }
              }
            }
          },
          "required": true
        },
        "outputParameters": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "appointmentreminderid": {
                      "description": "An athenaNet appointment reminder ID.",
                      "type": "integer"
                    },
                    "errormessage": {
                      "description": "If operation was unsuccessful, detail as to why.",
                      "type": "string"
                    },
                    "success": {
                      "description": "Indicates whether creation of the appointment reminder was successful or not.",
                      "enum": [
                        "",
                        false,
                        true
                      ],
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "exampleCode": "curl -X POST \"https://api.preview.platform.athenahealth.com/v1/{contextId}/appointments/appointmentreminders\" -H \"accept: application/json\" -H \"Authorization: Bearer {bearerToken}\" -H \"Content-Type: application/x-www-form-urlencoded\" -d \"appointmenttypeid={appointmenttypeId}&approximatedate={mm%2Fdd%2Fyyyy}&departmentid={departmentId}&note={freeText}&patientid={patientId}&patientinstructions={freeText}&providerid={providerId}\"",
        "tags": [
          "Appointments",
          "Appointment Reminders"
        ],
        "endpointFlags": {
          "x-internal-only": false,
          "x-omit-from-docs": false,
          "x-omit-from-try-it-now": false,
          "x-swagger-router-controller": "passthrough"
        },
        "certifiedApi": false
