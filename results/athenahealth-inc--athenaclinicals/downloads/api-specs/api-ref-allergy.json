      {
        "endpointTitle": "Update patient's allergies",
        "endpointDescription": "Modifies list of allergies documented in the patient chart",
        "apiCatalog": "Chart.yaml",
        "httpMethod": "PUT",
        "endpointUrl": "/v1/{practiceid}/chart/{patientid}/allergies",
        "operationId": "putPracticeidChartPatientidAllergies",
        "inputParameters": [
          {
            "in": "path",
            "name": "practiceid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "practiceid"
          },
          {
            "in": "path",
            "name": "patientid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "patientid"
          },
          {
            "in": "header",
            "name": "Content-Type",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Content type of the payload"
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "departmentid"
                ],
                "properties": {
                  "nkda": {
                    "type": "boolean",
                    "description": "Whether the patient has no known drug allergies. This is an explicit statement separate from a patient with no documented allergies so far. Note that while a patient can have this checked and have allergies, that is not recommended."
                  },
                  "allergies": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "note": {
                          "type": "string",
                          "description": "Note about this allergy"
                        },
                        "onsetdate": {
                          "type": "string",
                          "description": "Date of allergy onset"
                        },
                        "reactions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "severity": {
                                "type": "string",
                                "description": "Severity of the reaction"
                              },
                              "snomedcode": {
                                "type": "integer",
                                "description": "SNOMED code for this reaction"
                              },
                              "reactionname": {
                                "type": "string",
                                "description": "Name of the reaction"
                              },
                              "severitysnomedcode": {
                                "type": "integer",
                                "description": "SNOMED code for the severity of this reaction"
                              }
                            }
                          },
                          "description": "An optional list of reactions and associated severities this patient has to this allergen. Note that if you are updating the reactions or severities for a given allergen, PLEASE include all existing reactions and severties as well, as the update will override any existing entries."
                        },
                        "allergenid": {
                          "type": "integer",
                          "description": "Athena ID for this allergen."
                        },
                        "criticality": {
                          "type": "string",
                          "description": "The criticality of the allergen."
                        },
                        "allergenname": {
                          "type": "string",
                          "description": "The name of the allergen."
                        },
                        "deactivatedate": {
                          "type": "string",
                          "description": "Date of allergy deactivation. Set to deactivate the allergy"
                        },
                        "reactivatedate": {
                          "type": "string",
                          "description": "Date of allergy reactivation. Set to reactivate the allergy"
                        }
                      }
                    },
                    "required": [
                      "allergenid"
                    ],
                    "description": "A complex JSON object containing an update to the list of patient allergies. Any new allergies will be added, and any existing ones (based on allergenid) will be updated. If any existing ones are skipped, they will NOT be deleted. As such, this section can be empty if, for example, you just want to update NKDA status or the section note."
                  },
                  "sectionnote": {
                    "type": "string",
                    "description": "A section-wide note. Passing an empty string will remove any existing note."
                  },
                  "departmentid": {
                    "type": "integer",
                    "description": "The ID of the department for this patient. A patient may have multiple charts, and the department determines which chart to use."
                  },
                  "PATIENTFACINGCALL": {
                    "type": "boolean",
                    "description": "When 'true' is passed we will collect relevant data and store in our database."
                  },
                  "THIRDPARTYUSERNAME": {
                    "type": "string",
                    "description": "User name of the patient in the third party application."
                  }
                }
              }
            }
          },
          "required": true
        },
        "outputParameters": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "errormessage": {
                      "description": "If the update operation failed, this will contain any error messages.",
                      "type": "string"
                    },
                    "success": {
                      "description": "Whether the update operation was successful.",
                      "enum": [
                        "",
                        false,
                        true
                      ],
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "exampleCode": null,
