                          },
                          "allergenname": {
                            "description": "The name of the allergen.",
                            "type": "string"
                          },
                          "categories": {
                            "description": "The category or categories of the allergen (food, medication, environment).",
                            "type": "array"
                          },
                          "criticality": {
                            "description": "The criticality of the allergen.",
                            "type": "string"
                          },
