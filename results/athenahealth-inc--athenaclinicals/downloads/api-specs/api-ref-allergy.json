      {
        "endpointTitle": "Get patient's allergies",
        "endpointDescription": "Retrieves list of allergens, allergy reactions, severity documented in the patient chart",
        "apiCatalog": "Chart.yaml",
        "httpMethod": "GET",
        "endpointUrl": "/v1/{practiceid}/chart/{patientid}/allergies",
        "operationId": "getPracticeidChartPatientidAllergies",
        "inputParameters": [
          {
            "in": "path",
            "name": "practiceid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "practiceid"
          },
          {
            "in": "path",
            "name": "patientid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "patientid"
          },
          {
            "in": "query",
            "name": "departmentid",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "The athenaNet department id."
          },
          {
            "in": "query",
            "name": "showinactive",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "Include deactivated allergies"
          },
          {
            "in": "query",
            "name": "THIRDPARTYUSERNAME",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "User name of the patient in the third party application."
          },
          {
            "in": "query",
            "name": "PATIENTFACINGCALL",
            "schema": {
              "type": "boolean"
