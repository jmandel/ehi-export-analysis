[{"title":"Welcome to Electronic Health Information (EHI) Export from athenaOne!","site":"athenaone-dataexports","subtitle":null,"body":{"data":{},"content":[{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"uazigsvtldjw"}},"id":"23xdIS5dwxqA6SrRMLc082","type":"Entry","createdAt":"2023-05-30T15:02:54.109Z","updatedAt":"2024-03-25T14:40:55.680Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":36,"revision":6,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"component_styledContainer"}},"locale":"en-US"},"fields":{"title":"Exports Getting Started Page Body","className":"getting-started-page-body","body":{"nodeType":"document","data":{},"content":[{"nodeType":"embedded-entry-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"uazigsvtldjw"}},"id":"2dAWpWWhixaD9o1kIwT0B3","type":"Entry","createdAt":"2023-06-06T19:45:24.041Z","updatedAt":"2023-06-06T19:45:24.041Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":6,"revision":1,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"component_styledContainer"}},"locale":"en-US"},"fields":{"title":"Exports Overview Page Intro","className":"getting-started-introduction","body":{"nodeType":"document","data":{},"content":[{"nodeType":"embedded-entry-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"uazigsvtldjw"}},"id":"6o0z7iIcaXsss8bSbTKyYL","type":"Entry","createdAt":"2023-03-07T19:05:20.913Z","updatedAt":"2023-11-14T10:00:03.269Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":16,"revision":6,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"component_styledContainer"}},"locale":"en-US"},"fields":{"title":"Exports Overview Intro (Only Text)","className":"getting-started-introduction-text","body":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"This site describes the Electronic Health Information (EHI) Export capability provided in athenaOne. Electronic health information (EHI) export is a feature of athenaOne that allows consumers of the structured electronic health information to move or share patient's information. This page describes what EHI records are available, common use cases of export, and the types of EHI exports offered for consumers of the structured electronic health information, who can be customers of athenahealth or other authorized entities such as auditing firms, EHR conversion vendors. ","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Electronic Health Information (EHI) ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"EHI focuses on a set of health information that HIPAA covered entities and business associates currently collect, maintain, and make available for access, exchange, and use. For example, EHI is a subset of the same information in a HIPAA Designated Record Set, which may include: ","marks":[],"data":{}}]},{"nodeType":"ordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Medical records and billing records about individuals ","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Enrollment, payment, claims adjudication, and case or medical management record systems maintained by or for a health plan.  ","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Data used in whole or in part to make decisions about individuals.  ","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Note: Regulators have excluded certain information from the definition of EHI, such as psychotherapy notes. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}}]}]}}}},"content":[]},{"nodeType":"embedded-entry-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"uazigsvtldjw"}},"id":"1LY7vNghxI22J4lKe5CERV","type":"Entry","createdAt":"2023-06-06T19:44:38.776Z","updatedAt":"2023-06-06T19:44:38.776Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":5,"revision":1,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"component_styledImage"}},"locale":"en-US"},"fields":{"name":"Exports Overview Image","site":"athenaone-dataexports","image":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"uazigsvtldjw"}},"id":"5caObEIgYDVD1rTyB9dt5i","type":"Asset","createdAt":"2023-06-06T19:44:09.028Z","updatedAt":"2023-06-06T19:44:09.028Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":4,"revision":1,"locale":"en-US"},"fields":{"title":"Exports Graphic","description":"A file cabinet with folders","file":{"url":"//images.ctfassets.net/uazigsvtldjw/5caObEIgYDVD1rTyB9dt5i/6b21ac4fd138727731f0df0361cddcb3/Exports_Graphic.png","details":{"size":796115,"image":{"width":1612,"height":1124}},"fileName":"Exports Graphic.png","contentType":"image/png"}}},"alignment":"right"}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}}]}]}}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"EHI Export Use Cases","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"ordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Bulk EHI export","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" enables export of all patient data belonging to a practice, provider, medical group, or department. This provision to export all EHI will be enabled when providers or departments detach from a practice or when practices terminate from athenahealth.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Single/multi-patient export","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" is useful when patients request their health information or when their information is shared for referrals or authorized auditing purposes. ","marks":[],"data":{}}]}]}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Types of EHI Exports We Offer","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"EHI Export for athenaOne offers comprehensive and structured data that:  ","marks":[],"data":{}}]},{"nodeType":"ordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Includes patients’ health information as managed and exported from athenaClinicals, as well as demographic, billing information as managed and exported from athenaCollector for customers in the Ambulatory and Inpatient settings.  ","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Utilizes athenahealth’s ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"/api/docs/fhir-apis"},"content":[{"nodeType":"text","value":"standard RESTful FHIR APIs","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":" and several ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"/api/docs/athenaone-apis"},"content":[{"nodeType":"text","value":"proprietary healthcare API endpoints","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":" that foster interoperability.  ","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Is exported in machine readable formats such as Newline Delimited JSON or HTML (HTML 5).  ","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Includes, wherever relevant, additional human readable files in XML, JPEG, PNG, TIFF or PDF formats, which contain patient health information. Examples include encounter summaries, imaging results, scanned clinical documents, insurance ID card images, etc. ","marks":[],"data":{}}]}]}]},{"nodeType":"embedded-entry-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"uazigsvtldjw"}},"id":"7eFXSTSgK6BV5QRfk18X3k","type":"Entry","createdAt":"2023-05-30T15:02:48.945Z","updatedAt":"2023-05-30T16:28:09.824Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":9,"revision":3,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"component_styledContainer"}},"locale":"en-US"},"fields":{"title":"Exports Getting Started Welcome Page Cards Container","className":"getting-started-cards-container flex-container justify-space-between","body":{"data":{},"content":[{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id