      "examples": [
        {
          "context": "Document metadata example",
          "xml": "<Document>\n  <Document_id>939</Document_id>\n  <file_name>939.pdf</file_name>\n  <doc_name>Vitals</doc_name>\n  <last_modified_date>2022-04-21 11:35:14</last_modified_date>\n  <last_modified_by>1-USER</last_modified_by>\n  <document_folder_desc>Progress Notes</document_folder_desc>\n  <created_by>1-USER</created_by>\n  <created_date>2022-04-21</created_date>\n  <user_date>2022-04-21</user_date>\n  <description>Vitals</description>\n</Document>"
        }
      ]
    },
