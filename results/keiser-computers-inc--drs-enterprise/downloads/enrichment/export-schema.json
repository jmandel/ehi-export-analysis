          "optional": true
        },
        {
          "name": "user_date",
          "type": "Date",
          "description": "User Defined Date",
          "optional": true
        },
        {
          "name": "user_long",
          "type": "Int32",
          "description": "User Defined Number",
          "optional": true
        },
        {
          "name": "description",
          "type": "Text",
          "description": "Description",
          "optional": true
        },
        {
          "name": "description_long",
          "type": "Text",
          "description": "Long Description",
          "optional": true
