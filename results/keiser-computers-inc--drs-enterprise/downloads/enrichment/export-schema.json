{
  "vendor": "Keiser Computers, Inc.",
  "product": "Drs Enterprise",
  "document_date": "2023-11-07",
  "export_format": "C-CDA XML + proprietary XML sidecar files + raw document files",
  "export_standard": "HL7 C-CDA 2.1 (USCDv1)",
  "directory_structure": {
    "description": "Patient data exported in folders named by Account ID converted to hexadecimal, organized in 4 levels of 2-hex-digit folders (00-FF).",
    "path_pattern": "C:\\<data_export_folder_name>\\XX\\XX\\XX\\XX\\",
    "example": "Account ID 9999 → hex 270F → path 00\\00\\27\\0F"
  },
  "exported_files": [
    {
      "file_name": "account_ccda.xml",
      "description": "C-CDA XML containing the patient's EHI data (demographics, problems, medications, allergies, etc.) in compliance with USCDv1."
    },
    {
      "file_name": "account_tasks.xml",
      "description": "XML file containing task information linked to the patient account."
    },
    {
      "file_name": "Account_U.img",
      "description": "Patient's picture/photo if stored in the EHR."
    },
    {
      "file_name": "<Document_ID>.<ext>",
      "description": "Exported documents listed by Document ID. File types can be PDF, XML, TIF, RTF, or other formats depending on the source."
    },
    {
      "file_name": "<Document_ID>_info.xml",
      "description": "XML metadata file for each exported document, matching the Document ID."
    },
    {
      "file_name": "Readme.txt",
      "description": "Contains the publicly accessible hyperlink to the export documentation."
    },
    {
      "file_name": "errors_<Session_ID>.xml",
      "description": "Error log XML created in export_xml folder if errors occur during export."
    }
  ],
  "xml_entities": [
