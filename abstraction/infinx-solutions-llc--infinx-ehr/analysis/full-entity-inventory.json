{
  "source": "IMED-EHI-Export-Documentation.pdf (13 pages, 92,684 bytes)",
  "source_url": "https://www.infinx.com/wp-content/uploads/2025/09/IMED-Electronic-Health-Information-EHI-Export-Documentation-191223-221553-1.pdf",
  "export_format": {
    "container": ".zip file containing a folder of files",
    "file_types": [
      {
        "prefix": "*.csv",
        "extension": "csv",
        "description": "Patient data in patient tables. Header row with field names, followed by comma-separated data."
      },
      {
        "prefix": "ccda.xml",
        "extension": "xml",
        "description": "Main C-CDA export of all patient ccda-compatible data. Additional ccda_[id].xml files are referrals."
      },
      {
        "prefix": "SoapDoc_*",
        "extension": "pdf",
        "description": "Visit data from a particular patient visit (SOAP notes)."
      },
      {
        "prefix": "document_*",
        "extension": "pdf",
        "description": "Chart documents that may have been scanned or uploaded into the patient chart."
      },
      {
        "prefix": "Labs_*",
        "extension": "pdf",
        "description": "PDF lab results."
      },
      {
        "prefix": "formletter_*",
        "extension": "pdf",
        "description": "Letters the clinic has generated inside the patient's chart."
      },
      {
        "prefix": "OB_*",
        "extension": "pdf",
        "description": "Pregnancy-related visit data."
      }
    ]
  },
  "instructions": {
    "single_patient": "Instructions to initiate single patient export of EHI are available in the user guide.",
    "bulk_export": "For a bulk/multi-patient export of EHI, please contact support by creating a support ticket."
  },
